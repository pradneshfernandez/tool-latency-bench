            "title": "Address",
            "type": "string"
          },
          "email": {
            "description": "The verified user's email",
            "title": "Email",
            "type": "string"
          },
          "phone_number": {
            "description": "The verified user's phone number",
            "title": "Phone Number",
            "type": "string"
          },
          "date_of_birth": {
            "description": "The verified user's date of birth (MM/DD/YYYY format)",
            "title": "Date Of Birth",
            "type": "string"
          },
          "time_verified": {
            "description": "The timestamp of the verification (e.g., \"2025-11-14 03:40:00 EST\")",
            "title": "Time Verified",
            "type": "string"
          }
        },
        "required": [
          "name",
          "user_id",
          "address",
          "email",
          "phone_number",
          "date_of_birth",
