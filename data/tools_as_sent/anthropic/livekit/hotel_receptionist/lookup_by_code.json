{
  "tool_id": "livekit/hotel_receptionist/lookup_by_code.json",
  "provider": "anthropic",
  "framework": "livekit-agents + plugins 5b49888",
  "endpoint": "/v1/messages",
  "payload": {
    "name": "lookup_by_code",
    "description": "Look up a booking by last name + confirmation code.\n",
    "input_schema": {
      "properties": {
        "last_name": {
          "description": "Caller's last name.",
          "type": "string"
        },
        "code": {
          "description": "Confirmation code, e.g. 'HTL-7A3K'.",
          "type": "string"
        }
      },
      "required": [
        "last_name",
        "code"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "strict": true
  }
}
