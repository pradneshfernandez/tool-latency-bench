{
  "tool_id": "livekit/hotel_receptionist/cancel_restaurant_reservation.json",
  "provider": "anthropic",
  "framework": "livekit-agents + plugins 5b49888",
  "endpoint": "/v1/messages",
  "payload": {
    "name": "cancel_restaurant_reservation",
    "description": "Cancel a restaurant reservation. Restaurants verify with last name + confirmation code (no card, no email — the code is what we print when the table is booked).\n",
    "input_schema": {
      "properties": {
        "last_name": {
          "description": "caller's last name.",
          "type": "string"
        },
        "confirmation_code": {
          "description": "confirmation code like 'RES-X9Y2'.",
          "type": "string"
        }
      },
      "required": [
        "last_name",
        "confirmation_code"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "strict": true
  }
}
